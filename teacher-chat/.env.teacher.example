# Teacher Chat Stack — Environment Variables Template
# Copy this file to .env.teacher and fill in your values.
# .env.teacher is gitignored; this file is safe to commit.

# --- LLM API Key (used by litellm and librechat) ---
OLLAMA_API_KEY=your-api-key-here (for ollama just any string will do)

# --- Langfuse API Keys (used by litellm for tracing) ---
# Generate these in your Langfuse dashboard (Settings > API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=http://langfuse:3000

# --- Langfuse Postgres DB ---
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change-me-strong-password
LANGFUSE_DB_NAME=langfuse

# --- Langfuse App Secrets ---
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_SALT=change-me-salt

# --- Langfuse Initial Admin User ---
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-strong-password

# --- Host path to the datasets directory (no trailing slash) ---
# Absolute path on your host machine to the datasets folder
DATASETS_HOST_PATH=/path/to/your/datasets
