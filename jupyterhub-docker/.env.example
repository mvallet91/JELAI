# JELAI configuration
# ===================
# Copy this file to .env (in the same directory) and fill in the values,
# or run ./setup.sh in the repository root to make the file for you.
# The .env file contains secrets. Do not commit it.
#
# The tutor behavior (classification, interventions, prompts) is not set
# here. Teachers set it in middleware/inputs/agent_config.yaml or on the
# teacher settings page.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# One of:
#   ollama        Self-hosted Ollama server (no API key)
#   openai        OpenAI API
#   openwebui     Open WebUI server with an API key
#   groq          Groq (free tier available)
#   openrouter    OpenRouter (free models available, set LLM_MODEL)
#   gemini        Google Gemini API (free tier available)
#   mistral       Mistral AI (free monthly credits, EU)
#   ollama-cloud  Ollama Cloud (free tier available)
#   custom        Any other OpenAI-compatible server (set LLM_BASE_URL)
LLM_PROVIDER=ollama

# The API base URL. Leave empty to use the default URL of the provider.
# Examples:
#   ollama on the same machine:  http://host.docker.internal:11434/v1
#   ollama on another server:    http://my-gpu-server:11434/v1
#   openwebui:                   https://chat.example.org   (the server URL)
#   custom:                      https://llm.example.org/v1
LLM_BASE_URL=

# The API key. Not necessary for a local Ollama server.
LLM_API_KEY=

# The model for all tasks. Leave empty to use the default model of the provider.
LLM_MODEL=

# Optional: a different model for each task. A small, fast model is good
# for classification. On free tiers the limits often apply per model, so
# different models also spread the use over more quota.
LLM_MODEL_CLASSIFICATION=
LLM_MODEL_RESPONSE=
LLM_MODEL_EXPERT=
LLM_MODEL_PROACTIVITY=
LLM_MODEL_REPORT=

# Request timeout and retries after a rate limit (HTTP 429) or server error.
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# The JupyterHub user that is admin. Sign up with this name first.
JUPYTERHUB_ADMIN=admin
# true: new users can log in without approval by the admin.
JUPYTERHUB_OPEN_SIGNUP=false

# Password for the teacher dashboard and settings page (user name: teacher).
# If it is empty, the teacher pages are disabled.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------
JUPYTERHUB_PORT=8000
TEACHER_DASHBOARD_PORT=8004
ETHERPAD_PORT=9001

# ---------------------------------------------------------------------------
# Resources of each student notebook
# ---------------------------------------------------------------------------
NOTEBOOK_MEM_LIMIT=1G
NOTEBOOK_CPU_LIMIT=0.5
# Stop a notebook server after this many seconds without activity.
NOTEBOOK_IDLE_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Etherpad (collaborative writing, used by the learner model)
# ---------------------------------------------------------------------------
# The API key is in jupyterhub-docker/etherpad/APIKEY.txt (setup.sh makes it).
# To disable Etherpad, set ETHERPAD_ENABLED=false and remove "etherpad"
# from COMPOSE_PROFILES.
ETHERPAD_ENABLED=true
COMPOSE_PROFILES=etherpad

# Number of worker processes of the tutor and expert agents.
TA_WORKERS=2
EA_WORKERS=2
